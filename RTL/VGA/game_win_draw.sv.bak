module game_win_draw (  
    input  logic clk,
    input  logic resetN,
    input  logic [10:0] pixelX,
    input  logic [10:0] pixelY,
    input  logic draw,
	 
    output logic [7:0] BG_GAME_WIN_RGB,
    output logic       bg_game_win_dr,
	 output logic dim_screen_req
);

localparam logic [7:0] TRANSPARENT_ENCODING = 8'hFF; 

localparam int IMAGE_WIDTH  = 334;
localparam int IMAGE_HEIGHT = 284;
// Centered for 640x480 screen: (480-334)/2 = 73, (480-284)/2 = 98
localparam int OFFSET_X = 73; 
localparam int OFFSET_Y = 98;  

logic [18:0] address;
logic [10:0] local_X;
logic [10:0] local_Y;
logic [7:0] MIF_VGA;

// Calculate local coordinates relative to the image bounding box
assign local_X = pixelX - OFFSET_X;
assign local_Y = pixelY - OFFSET_Y;
assign address = (local_Y * IMAGE_WIDTH) + local_X;

assign dim_screen_req = draw;

lpm_rom #(
    .LPM_WIDTH(8),
    .LPM_WIDTHAD(17), 
    .LPM_NUMWORDS(94856),
    .LPM_FILE("RTL/background_game_over.mif"), 
    .LPM_TYPE               ("LPM_ROM"),
    .LPM_ADDRESS_CONTROL    ("REGISTERED"), 
    .LPM_OUTDATA            ("UNREGISTERED"), 
    .AUTO_CARRY_CHAINS      ("ON"),
    .AUTO_CASCADE_BUFFERS   ("ON"),
    .INTENDED_DEVICE_FAMILY ("Cyclone V")  
) rom_inst_gameover (
    .address(address),
    .inclock(clk),
    .q(MIF_VGA)
);

always_ff@(posedge clk or negedge resetN) begin
    if(!resetN) begin
        BG_GAME_WIN_RGB <= 8'h00;
        bg_game_win_dr <= 1'b0; 
    end 
    else begin
        // Check if drawing is enabled and beam is within the bounding box
        if (draw && (pixelX >= OFFSET_X) && (pixelX < OFFSET_X + IMAGE_WIDTH) && 
                    (pixelY >= OFFSET_Y) && (pixelY < OFFSET_Y + IMAGE_HEIGHT)) begin
            BG_GAME_WIN_RGB <= MIF_VGA; 
            // Draw only if the pixel is not transparent
            bg_game_win_dr <= (MIF_VGA != TRANSPARENT_ENCODING) ? 1'b1 : 1'b0; 
        end else begin
            bg_game_win_dr <= 1'b0; 
            BG_GAME_WIN_RGB <= 8'h00; 
        end
    end 
end
endmodule