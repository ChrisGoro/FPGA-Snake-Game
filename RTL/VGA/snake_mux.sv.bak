module snake_mux (
    input  logic       headDR,  
    input  logic [7:0] headRGB, 
    
    input  logic       bodyDR,  
    input  logic [7:0] bodyRGB, 
    
    output logic       finalDR,
    output logic [7:0] finalRGB 
);


assign finalDR = headDR | bodyDR;

// head has strict priority over body 
assign finalRGB = (headDR == 1'b1) ? headRGB : bodyRGB;

endmodule