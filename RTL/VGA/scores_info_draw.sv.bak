module scores_info_draw (  
    input  logic clk,
    input  logic resetN,
    input  logic [10:0] pixelX,
    input  logic [10:0] pixelY,
  
    output logic [7:0] BG_RGB,
    output logic       bg_scores_info_dr, 
);

localparam logic [7:0] TRANSPARENT_ENCODING = 8'hFF; 

localparam int IMAGE_WIDTH = 124;

logic [14:0] address;

logic [7:0] MIF_VGA;

assign address = (pixelY * IMAGE_WIDTH) + pixelX;

lpm_rom #(
    .LPM_WIDTH(8),
    .LPM_WIDTHAD(28644), // Вставь LPM_WIDTHAD из скрипта
    .LPM_NUMWORDS(15),// Вставь LPM_NUMWORDS из скрипта
    .LPM_FILE("RTL/background_scores_info.mif"), 
    .LPM_TYPE               ("LPM_ROM"),
    .LPM_ADDRESS_CONTROL    ("REGISTERED"), 
    .LPM_OUTDATA            ("UNREGISTERED"), 
    .AUTO_CARRY_CHAINS      ("ON"),
    .AUTO_CASCADE_BUFFERS   ("ON"),
    .INTENDED_DEVICE_FAMILY ("Cyclone V")  
) rom_inst_scores (
    .address(address),
    .inclock(clk),
    .q(MIF_VGA)
);

always_ff@(posedge clk or negedge resetN) begin
    if(!resetN) begin
        BG_RGB <= 8'h00;
        bg_scores_info_dr <= 1'b0; 
    end 
    else begin
        bg_scores_info_dr <= 1'b1; 
        BG_RGB <= MIF_VGA; 
    end 
end
endmodule