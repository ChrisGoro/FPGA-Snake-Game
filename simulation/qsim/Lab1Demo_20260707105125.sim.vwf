TRANSITION_LIST("up_direction_key")
{
	NODE
	{
		REPEAT = 1;
		NODE
		{
			REPEAT = 1;
			LEVEL 0 FOR 800.0;
			LEVEL 1 FOR 80.0;
			LEVEL 0 FOR 9120.0;
		}
	}
}

